# Copia este archivo a .env y rellena los valores.

# ERP de producción (SQL Server GOMEZYCRESPO). Única fuente de datos de la
# app, siempre en solo lectura: aquí no se escribe nunca.
SQLSERVER_HOST=10.0.0.6
SQLSERVER_DB=GOMEZYCRESPO
SQLSERVER_USER=
SQLSERVER_PASS=

# Ficha de máquinas que pueden trabajar solas (una por línea, "matrícula<TAB>nombre").
# La declara producción: qué máquina cicla sin nadie encima no se deduce de un
# histórico. Cuánta atención pide cada una sí se mide sola. Sin ficha, todo bono
# ata a su operario de principio a fin.
FICHA_MAQUINAS_AUTO=maquinas-auto.txt
